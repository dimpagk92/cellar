{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/npm",
      {
        "pkgRoot": "mcp-server"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "pkgRoot": "cel/cel-napi"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "cel/cel-napi/cel-napi.darwin-arm64.node", "label": "cel-napi macOS arm64" },
          { "path": "cel/cel-napi/cel-napi.darwin-x64.node",   "label": "cel-napi macOS x64" },
          { "path": "cel/cel-napi/cel-napi.linux-x64-gnu.node","label": "cel-napi Linux x64" },
          { "path": "cel/cel-napi/cel-napi.linux-arm64-gnu.node","label": "cel-napi Linux arm64" },
          { "path": "cel/cel-napi/cel-napi.win32-x64-msvc.node","label": "cel-napi Windows x64" }
        ]
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "mcp-server/package.json", "cel/cel-napi/package.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
