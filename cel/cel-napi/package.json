{
  "name": "@dpagk/cellar-napi",
  "version": "0.1.0",
  "description": "CEL native bindings via napi-rs",
  "main": "index.js",
  "files": [
    "index.js",
    "cel-napi.darwin-arm64.node",
    "cel-napi.darwin-x64.node",
    "cel-napi.linux-x64-gnu.node",
    "cel-napi.linux-x64-musl.node",
    "cel-napi.linux-arm64-gnu.node",
    "cel-napi.win32-x64-msvc.node"
  ],
  "napi": {
    "name": "cel-napi",
    "triples": {
      "defaults": false,
      "additional": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc"
      ]
    }
  }
}
